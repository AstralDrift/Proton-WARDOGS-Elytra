+/* Initialize the /GS cookie in a kernel image before calling its entry point.
+ * User-mode images are handled by ntdll's loader, but native Windows performs
+ * the equivalent operation for drivers in the kernel image loader. */
+static void initialize_driver_security_cookie( HMODULE module )
+{
+    IMAGE_LOAD_CONFIG_DIRECTORY *cfg;
+    const IMAGE_NT_HEADERS *nt;
+    ULONG_PTR *cookie, value;
+    LARGE_INTEGER counter, system_time;
+    ULONG size;
+
+    if (!(nt = RtlImageNtHeader( module ))) return;
+    if (!(cfg = RtlImageDirectoryEntryToData( module, TRUE,
