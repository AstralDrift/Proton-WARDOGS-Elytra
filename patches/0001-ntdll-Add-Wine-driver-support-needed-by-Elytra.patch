diff --git a/dlls/bcrypt/gnutls.c b/dlls/bcrypt/gnutls.c
index 4603c7d..c821083 100644
--- a/dlls/bcrypt/gnutls.c
+++ b/dlls/bcrypt/gnutls.c
@@ -932,17 +932,31 @@ static NTSTATUS key_symmetric_encrypt( void *args )
 static NTSTATUS key_symmetric_decrypt( void *args )
 {
     const struct key_symmetric_decrypt_params *params = args;
+    unsigned char stack_input[32], *allocated_input = NULL;
+    const unsigned char *input = params->input;
     NTSTATUS status;
     int ret;
 
     if ((status = init_cipher_handle( params->key ))) return status;
 
-    if ((ret = pgnutls_cipher_decrypt2( key_data(params->key)->cipher, params->input, params->input_len,
+    /* BCrypt permits in-place operation.  Do not depend on the crypto backend
+     * preserving overlapping input while it writes the decrypted block. */
+    if ((ULONG_PTR)params->input < (ULONG_PTR)params->output + params->output_len &&
+        (ULONG_PTR)params->output < (ULONG_PTR)params->input + params->input_len)
+    {
+        if (params->input_len <= sizeof(stack_input)) input = stack_input;
+        else if (!(input = allocated_input = malloc( params->input_len ))) return STATUS_NO_MEMORY;
+        memcpy( (void *)input, params->input, params->input_len );
+    }
+
+    if ((ret = pgnutls_cipher_decrypt2( key_data(params->key)->cipher, input, params->input_len,
                                         params->output, params->output_len )))
     {
         pgnutls_perror( ret );
+        free( allocated_input );
         return STATUS_INTERNAL_ERROR;
     }
+    free( allocated_input );
     return STATUS_SUCCESS;
 }
 
