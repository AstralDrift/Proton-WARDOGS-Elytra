+/*
+ * NtLoadDriver is normally a kernel syscall.  Wine hosts native PE drivers in
+ * winedevice.exe, which is started and supervised by services.exe.  Route the
+ * request through the SCM so that the existing driver host performs the real
+ * image load and DriverEntry call; do not report success unless that path does.
+ *
+ * ntdll cannot import advapi32 without introducing a loader cycle, so resolve
+ * the small SCM surface lazily after process initialization.
+ */
+NTSTATUS WINAPI NtLoadDriver( const UNICODE_STRING *key_name )
+{
+    static const WCHAR services_prefix[] = L"\\Registry\\Machine\\System\\CurrentControlSet\\Services\\";
+    static HMODULE advapi32;
+    static HANDLE (WINAPI *pOpenSCManagerW)( const WCHAR *, const WCHAR *, DWORD );
+    static HANDLE (WINAPI *pOpenServiceW)( HANDLE, const WCHAR *, DWORD );
+    static HANDLE (WINAPI *pCreateServiceW)( HANDLE, const WCHAR *, const WCHAR *, DWORD, DWORD,
+                                             DWORD, DWORD, const WCHAR *, const WCHAR *, DWORD *,
+                                             const WCHAR *, const WCHAR *, const WCHAR * );
+    static BOOL (WINAPI *pStartServiceW)( HANDLE, DWORD, const WCHAR ** );
+    static BOOL (WINAPI *pCloseServiceHandle)( HANDLE );
+    static LSTATUS (WINAPI *pRegOpenKeyExW)( HKEY, const WCHAR *, DWORD, REGSAM, HKEY * );
+    static LSTATUS (WINAPI *pRegQueryValueExW)( HKEY, const WCHAR *, DWORD *, DWORD *, BYTE *, DWORD * );
+    static LSTATUS (WINAPI *pRegCloseKey)( HKEY );
+    ANSI_STRING proc_name;
+    UNICODE_STRING module_name = RTL_CONSTANT_STRING(L"advapi32.dll");
+    PRIVILEGE_SET required;
+    BOOLEAN allowed = FALSE;
+    HANDLE token = 0, manager = 0, service = 0;
+    WCHAR *name, *image_path = NULL, *registry_path = NULL;
+    HKEY driver_key = 0;
+    DWORD error, open_error = ERROR_SUCCESS, type = SERVICE_KERNEL_DRIVER;
+    DWORD start = SERVICE_DEMAND_START, error_control = SERVICE_ERROR_NORMAL, size, value_type;
+    NTSTATUS status;
+    unsigned int prefix_len = ARRAY_SIZE(services_prefix) - 1;
+
+    TRACE("(%s)\n", debugstr_us(key_name));
+
+    if (!key_name || !key_name->Buffer || (key_name->Length & 1) ||
+        key_name->Length <= prefix_len * sizeof(WCHAR) ||
+        wcsnicmp(key_name->Buffer, services_prefix, prefix_len))
+        return STATUS_INVALID_PARAMETER;
+
+    required.PrivilegeCount = 1;
+    required.Control = PRIVILEGE_SET_ALL_NECESSARY;
+    required.Privilege[0].Luid.LowPart = SE_LOAD_DRIVER_PRIVILEGE;
+    required.Privilege[0].Luid.HighPart = 0;
+    required.Privilege[0].Attributes = SE_PRIVILEGE_ENABLED;
+
+    status = NtOpenThreadToken(GetCurrentThread(), TOKEN_QUERY, FALSE, &token);
+    if (status == STATUS_NO_TOKEN)
+        status = NtOpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token);
+    if (status) return status;
+    status = NtPrivilegeCheck(token, &required, &allowed);
+    NtClose(token);
+    if (status) return status;
+    if (!allowed) return STATUS_PRIVILEGE_NOT_HELD;
+
+    if (!advapi32 && (status = LdrLoadDll(NULL, NULL, &module_name, &advapi32))) return status;
+
+#define RESOLVE_SCM_PROC(name) do { \
+        RtlInitAnsiString(&proc_name, #name); \
+        if ((status = LdrGetProcedureAddress(advapi32, &proc_name, 0, (void **)&p##name))) return status; \
+    } while (0)
+    if (!pOpenSCManagerW)
+    {
+        RESOLVE_SCM_PROC(OpenSCManagerW);
+        RESOLVE_SCM_PROC(OpenServiceW);
+        RESOLVE_SCM_PROC(CreateServiceW);
+        RESOLVE_SCM_PROC(StartServiceW);
+        RESOLVE_SCM_PROC(CloseServiceHandle);
+        RESOLVE_SCM_PROC(RegOpenKeyExW);
+        RESOLVE_SCM_PROC(RegQueryValueExW);
+        RESOLVE_SCM_PROC(RegCloseKey);
+    }
+#undef RESOLVE_SCM_PROC
+
+    if (!(name = RtlAllocateHeap(GetProcessHeap(), 0,
+                                 key_name->Length - prefix_len * sizeof(WCHAR) + sizeof(WCHAR))))
+        return STATUS_NO_MEMORY;
+    memcpy(name, key_name->Buffer + prefix_len,
+           key_name->Length - prefix_len * sizeof(WCHAR));
+    name[key_name->Length / sizeof(WCHAR) - prefix_len] = 0;
+    if (!name[0] || wcschr(name, '\\'))
+    {
+        RtlFreeHeap(GetProcessHeap(), 0, name);
+        return STATUS_INVALID_PARAMETER;
+    }
+
+    manager = pOpenSCManagerW(NULL, NULL, SC_MANAGER_CONNECT | SC_MANAGER_CREATE_SERVICE);
+    if (manager)
+    {
+        service = pOpenServiceW(manager, name, SERVICE_START | SERVICE_QUERY_STATUS);
+        if (!service) open_error = RtlGetLastWin32Error();
+    }
+
+    /* Native callers may create a driver service by writing its registry key
+     * directly before NtLoadDriver().  services.exe caches its database, so
+     * import that configuration through CreateServiceW when necessary. */
+    if (manager && !service && open_error == ERROR_SERVICE_DOES_NOT_EXIST)
+    {
+        static const WCHAR registry_prefix[] = L"SYSTEM\\CurrentControlSet\\Services\\";
+        unsigned int registry_len = ARRAY_SIZE(registry_prefix) + wcslen(name);
+
+        if ((registry_path = RtlAllocateHeap(GetProcessHeap(), 0, registry_len * sizeof(WCHAR))))
+        {
+            wcscpy(registry_path, registry_prefix);
+            wcscat(registry_path, name);
+            if (!pRegOpenKeyExW(HKEY_LOCAL_MACHINE, registry_path, 0, KEY_QUERY_VALUE, &driver_key))
+            {
+                size = sizeof(type);
+                pRegQueryValueExW(driver_key, L"Type", NULL, &value_type, (BYTE *)&type, &size);
+                size = sizeof(start);
+                pRegQueryValueExW(driver_key, L"Start", NULL, &value_type, (BYTE *)&start, &size);
+                size = sizeof(error_control);
+                pRegQueryValueExW(driver_key, L"ErrorControl", NULL, &value_type,
+                                  (BYTE *)&error_control, &size);
+                size = 0;
+                error = pRegQueryValueExW(driver_key, L"ImagePath", NULL, &value_type, NULL, &size);
+                if ((error == ERROR_SUCCESS || error == ERROR_MORE_DATA) &&
+                    (value_type == REG_SZ || value_type == REG_EXPAND_SZ) &&
+                    (image_path = RtlAllocateHeap(GetProcessHeap(), HEAP_ZERO_MEMORY, size + sizeof(WCHAR))))
+                {
+                    if (!pRegQueryValueExW(driver_key, L"ImagePath", NULL, &value_type,
+                                           (BYTE *)image_path, &size) &&
+                        (type == SERVICE_KERNEL_DRIVER || type == SERVICE_FILE_SYSTEM_DRIVER))
+                        service = pCreateServiceW(manager, name, name,
+                                                  SERVICE_START | SERVICE_QUERY_STATUS,
+                                                  type, start, error_control, image_path,
+                                                  NULL, NULL, NULL, NULL, NULL);
+                }
+                pRegCloseKey(driver_key);
+            }
+        }
+    }
+    RtlFreeHeap(GetProcessHeap(), 0, name);
+    RtlFreeHeap(GetProcessHeap(), 0, registry_path);
+    RtlFreeHeap(GetProcessHeap(), 0, image_path);
+    if (service && pStartServiceW(service, 0, NULL)) error = ERROR_SUCCESS;
+    else error = RtlGetLastWin32Error();
+    if (service) pCloseServiceHandle(service);
+    if (manager) pCloseServiceHandle(manager);
+
+    switch (error)
+    {
+    case ERROR_SUCCESS:                 return STATUS_SUCCESS;
+    case ERROR_ACCESS_DENIED:           return STATUS_ACCESS_DENIED;
+    case ERROR_FILE_NOT_FOUND:
+    case ERROR_PATH_NOT_FOUND:
+    case ERROR_SERVICE_DOES_NOT_EXIST:  return STATUS_OBJECT_NAME_NOT_FOUND;
+    case ERROR_SERVICE_DISABLED:        return STATUS_UNSUCCESSFUL;
+    case ERROR_SERVICE_ALREADY_RUNNING: return STATUS_IMAGE_ALREADY_LOADED;
+    case ERROR_BAD_EXE_FORMAT:          return STATUS_INVALID_IMAGE_FORMAT;
+    case ERROR_NOT_ENOUGH_MEMORY:       return STATUS_NO_MEMORY;
+    case ERROR_INVALID_PARAMETER:       return STATUS_INVALID_PARAMETER;
+    default:
+        WARN("driver service start failed with Win32 error %lu\n", error);
+        return STATUS_UNSUCCESSFUL;
+    }
+}
