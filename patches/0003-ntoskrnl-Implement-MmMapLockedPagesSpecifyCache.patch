From 686ebe93b15dbf407d96ad42059bc02f2c8eb4db Mon Sep 17 00:00:00 2001
From: AstralDrift <190562877+AstralDrift@users.noreply.github.com>
Date: Thu, 3 Sep 2026 18:05:50 -0500
Subject: [PATCH 3/3] ntoskrnl: Implement MmMapLockedPagesSpecifyCache

---
 dlls/ntoskrnl.exe/ntoskrnl.c     | 7 +++++--
 dlls/ntoskrnl.exe/tests/driver.c | 1 -
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/dlls/ntoskrnl.exe/ntoskrnl.c b/dlls/ntoskrnl.exe/ntoskrnl.c
index bd8e19a..e036a6d 100644
--- a/dlls/ntoskrnl.exe/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/ntoskrnl.c
@@ -3009,9 +3009,12 @@ PVOID WINAPI MmMapLockedPages( MDL *mdl, KPROCESSOR_MODE mode )
 PVOID WINAPI  MmMapLockedPagesSpecifyCache(PMDLX MemoryDescriptorList, KPROCESSOR_MODE AccessMode, MEMORY_CACHING_TYPE CacheType,
                                            PVOID BaseAddress, ULONG BugCheckOnFailure, MM_PAGE_PRIORITY Priority)
 {
-    FIXME("(%p, %u, %u, %p, %lu, %u): stub\n", MemoryDescriptorList, AccessMode, CacheType, BaseAddress, BugCheckOnFailure, Priority);
+    TRACE("%p, %u, %u, %p, %lu, %u\n", MemoryDescriptorList, AccessMode, CacheType, BaseAddress,
+          BugCheckOnFailure, Priority);
 
-    return NULL;
+    /* Wine models locked pages as memory already mapped into the shared
+     * address space, so no distinct cache-attribute mapping is necessary. */
+    return MmMapLockedPages(MemoryDescriptorList, AccessMode);
 }
 
 /***********************************************************************
diff --git a/dlls/ntoskrnl.exe/tests/driver.c b/dlls/ntoskrnl.exe/tests/driver.c
index f30c340..cfba392 100644
--- a/dlls/ntoskrnl.exe/tests/driver.c
+++ b/dlls/ntoskrnl.exe/tests/driver.c
@@ -295,7 +295,6 @@ static void test_mdl_map(void)
     MmUnmapLockedPages(addr, mdl);
 
     addr = MmMapLockedPagesSpecifyCache(mdl, KernelMode, MmCached, NULL, FALSE, NormalPagePriority);
-    todo_wine
     ok(addr != NULL, "MmMapLockedPagesSpecifyCache failed\n");
     if (addr != NULL)
         ok(!kmemcmp(addr, buffer, sizeof(buffer)), "Unexpected data in mapped memory\n");
